    <!-- Deixa a API REST privada, apenas usuários devem ter acesso -->
    <security-constraint>
        <display-name>SampleRest API v1</display-name>
        <web-resource-collection>
            <web-resource-name>SampleRest API v1</web-resource-name>
            <description>SampleRest API v1</description>
            <url-pattern>/index.html</url-pattern>
            <url-pattern>/rest/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description>API v1</description>
            <role-name>admin</role-name>
        </auth-constraint>
    </security-constraint>


    <security-role>
        <role-name>totvstech</role-name>
    </security-role>
    <security-role>
        <role-name>user</role-name>
    </security-role>
    <security-role>
        <role-name>sysadmin</role-name>
    </security-role>
    <security-role>
        <role-name>admin</role-name>
    </security-role>

    <error-page>
        <error-code>403</error-code>
        <location>/erro.html</location>
    </error-page>
</web-app>
